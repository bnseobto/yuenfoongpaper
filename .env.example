# 複製成 .env 後填入真值（.env 已被 .gitignore 排除，切勿 commit）

# ── 文字模型（名片/文案的品牌包 JSON）—— OpenAI 相容 chat/completions ──
YFP_UPSTREAM_URL=https://api.openai.com/v1/chat/completions
YFP_UPSTREAM_KEY=sk-請填入你的金鑰
YFP_MODEL=gpt-4o-mini
#  ⚠️ 這裡務必填「文字」模型（gpt-4o-mini 等）。
#     不要填 gpt-image-2 之類的文生圖模型，否則 /api/design 會回 server_error。

# ── 文生圖（海報主視覺）—— OpenAI images/generations ──
#    沿用上面同一把金鑰；要關閉文生圖設 YFP_IMAGE_ENABLED=0
YFP_IMAGE_MODEL=gpt-image-2
YFP_IMAGE_QUALITY=medium       # low / medium / high（越高越貴）
YFP_IMAGE_SIZE=1024x1536       # 直式海報；長寬須為 16 倍數
YFP_IMAGE_RATE_MAX=5           # 文生圖每 IP 每分鐘上限（較嚴，控成本）
# YFP_IMAGE_KEY=               # 若文生圖用不同金鑰才需設，否則留空沿用 YFP_UPSTREAM_KEY
# YFP_IMAGE_ENABLED=0          # 取消註解可停用 /api/poster

# 允許的前端來源已在 docker-compose.yml 設為 https://yunprint.taozhuai.com
# 換文字供應商（Gemini Flash / DeepSeek）只改上面文字三行，不必動程式碼。
