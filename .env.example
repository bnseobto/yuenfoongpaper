# 複製成 .env 後填入真值（.env 已被 .gitignore 排除，切勿 commit）
# 上游 LLM —— OpenAI 相容的 chat/completions 端點
YFP_UPSTREAM_URL=https://api.openai.com/v1/chat/completions
YFP_UPSTREAM_KEY=sk-請填入你的金鑰
YFP_MODEL=gpt-4o-mini

# 允許的前端來源已在 docker-compose.yml 設為 https://yunprint.taozhuai.com
# 若要改用其他供應商（如 Gemini Flash / DeepSeek），只改上面三行、不必動程式碼。
